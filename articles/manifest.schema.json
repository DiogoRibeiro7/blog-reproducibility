{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Article reproducibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "website", "articles"],
  "properties": {
    "schema_version": {"const": 1},
    "website": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "branch": {"type": "string", "minLength": 1}
      }
    },
    "articles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"$ref": "#/$defs/article"}
    },
    "drafts": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"$ref": "#/$defs/draft"}
    }
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"},
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules", "figure_scripts", "generated_figures",
        "tests", "original_website_sources", "migration"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "permalink": {"type": "string", "pattern": "^/[^\\s]+/$"},
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^blog_reproducibility(?:\\.[a-z_][a-z0-9_]*)+$"}
        },
        "figure_scripts": {"$ref": "#/$defs/paths"},
        "benchmark_harness": {"$ref": "#/$defs/path"},
        "generated_figures": {"$ref": "#/$defs/paths"},
        "tests": {"$ref": "#/$defs/paths"},
        "data_inputs": {
          "type": "array",
          "description": "Local inputs under data/. Omit or use [] when no files are required.",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "original_website_sources": {"$ref": "#/$defs/paths"},
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerical_model", "reproducibility_tests", "figure_renderer", "website_cleanup"],
          "properties": {
            "numerical_model": {"enum": ["pending", "migrated"]},
            "reproducibility_tests": {"enum": ["pending", "migrated"]},
            "figure_renderer": {"enum": ["pending", "migrated"]},
            "website_cleanup": {"enum": ["pending", "complete"]}
          }
        }
      }
    },
    "article": {
      "$ref": "#/$defs/record",
      "required": ["path", "permalink"],
      "properties": {"path": {"pattern": "^_posts/.+\\.md$"}}
    },
    "draft": {
      "$ref": "#/$defs/record",
      "required": ["path"],
      "properties": {
        "path": {"pattern": "^_drafts/.+\\.md$"},
        "permalink": false
      }
    }
  }
}
